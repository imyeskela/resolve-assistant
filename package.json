{
  "name": "resolve-assistant-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local Windows development prototype of a DaVinci Resolve Workflow Integration",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "runtime:setup": "node scripts/setup-runtime.cjs",
    "browser:install": "node scripts/run.cjs scripts/install-browser.cjs",
    "test": "node scripts/run.cjs --test --test-concurrency=1 tests/*.test.cjs",
    "check": "node scripts/run.cjs scripts/check.cjs",
    "smoke": "node scripts/run.cjs scripts/smoke.cjs",
    "install:resolve": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-plugin.ps1",
    "stage": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-plugin.ps1 -StageOnly"
  },
  "overrides": {
    "hyperframes": {
      "undici": "7.30.1"
    }
  },
  "dependencies": {
    "@openai/codex": "0.166.0",
    "@puppeteer/browsers": "3.2.6",
    "@remotion/player": "4.0.534",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "hyperframes": "0.8.221",
    "jose": "6.2.14",
    "puppeteer-core": "25.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  }
}
